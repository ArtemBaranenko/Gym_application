<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="gym_assistant.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:gym_assistant"
    Title="gym_assistant">

    <TabBar>
        <Tab Icon="main.png">
            <ShellContent
                Title="Home"
                ContentTemplate="{DataTemplate local:MainPage}"
                Route="MainPage"/>
        </Tab>

        <Tab Icon="stats.png">
            <ShellContent
                Title="Progress"
                ContentTemplate="{DataTemplate local:ProgressPage}"
                Route="ProgressPage"/>
        </Tab>

        <Tab Icon="ai.png">
            <ShellContent
                Title="AI"
                ContentTemplate="{DataTemplate local:AiPage}"
                Route="AiPage"/>
        </Tab>

        <Tab Icon="workouts.png">
            <ShellContent
                Title="Workout"
                ContentTemplate="{DataTemplate local:WorkoutPage}"
                Route="WorkoutPage"/>
        </Tab>

        <Tab Icon="notes.png">
            <ShellContent
                Title="Journal"
                ContentTemplate="{DataTemplate local:JournalPage}"
                Route="JournalPage"/>
        </Tab>
    </TabBar>
</Shell>
