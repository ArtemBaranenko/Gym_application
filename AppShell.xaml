<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="gym_assistant.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:gym_assistant"
    Title="gym_assistant">

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage"/>

        <ShellContent
            Title="Progress"
            ContentTemplate="{DataTemplate local:ProgressPage}"
            Route="ProgressPage"/>

        <ShellContent
            Title="Workout"
            ContentTemplate="{DataTemplate local:WorkoutPage}"
            Route="WorkoutPage"/>

        <ShellContent
            Title="Journal"
            ContentTemplate="{DataTemplate local:JournalPage}"
            Route="JournalPage"/>

        <ShellContent
            Title="AI"
            ContentTemplate="{DataTemplate local:AiPage}"
            Route="AiPage"/>
    </TabBar>
</Shell>
