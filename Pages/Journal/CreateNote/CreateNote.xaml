<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="gym_assistant.CreateNotePage">

    <Shell.TitleView>
        <Label Text="Create Note"
               FontFamily="KumarOne-Regular"
               FontSize="22"
               HorizontalOptions="Center"
               VerticalOptions="Center"/>
    </Shell.TitleView>

    <VerticalStackLayout>
        <Editor Text="{Binding NoteTitle}"
                Placeholder="Title:"
                AutoSize="TextChanges"/>

        <Label
            Text="⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
            FontSize="12"
            Margin="0,0,0,20"/>

        <Editor Text="{Binding NoteText}"
                Placeholder="Note:"
                AutoSize="TextChanges"
                MaximumHeightRequest="600"/>

        <Button Text="Save Note"
                Command="{Binding SaveCommand}"/>
    </VerticalStackLayout>

</ContentPage>