<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="gym_assistant.JournalPage">

    <Shell.TitleView>
        <Label Text="Journal"
               FontFamily="KumarOne-Regular"
               FontSize="32"
               HorizontalOptions="Center"
               VerticalOptions="Center"/>
    </Shell.TitleView>

    <VerticalStackLayout>
        <Editor x:Name="noteEditor"
                Placeholder="Enter note here"
                AutoSize="TextChanges"
                BackgroundColor="Gray"/>
        <Button Text="Save Note"
                Clicked="onSaveClicked"/>
        <CollectionView x:Name="notesListView"
                        BackgroundColor="Gray"
                        MaximumHeightRequest="450">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="10">

                        <Label
                            Text="{Binding Note}"
                            FontSize="16"
                            FontAttributes="Bold"/>

                        <Label
                            Text="{Binding NoteDate}"
                            FontSize="12"
                            FontAttributes="Bold"/>

                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Text="Refresh"
                Clicked="onRefreshClicked"/>

        <Button Text="Create Note"
                Clicked="OnCreateWorkoutClicked"/>

    </VerticalStackLayout>


</ContentPage>
