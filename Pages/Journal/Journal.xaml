<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="gym_assistant.JournalPage">

    <Shell.TitleView>
        <Label Text="Journal"
               FontFamily="KumarOne-Regular"
               FontSize="32"
               HorizontalOptions="Center"
               VerticalOptions="Center"/>
    </Shell.TitleView>

    <VerticalStackLayout>

        <Button Text="Create Note"
                Command="{Binding OpenCreateNoteCommand}"/>
        <CollectionView ItemsSource="{Binding Notes}"
                        SelectionMode="Single"
                        SelectionChangedCommand="{Binding OpenNoteCommand}"
                        SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}}"
                        HeightRequest="650">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="10">
                        <Label
                            Text="{Binding Title}"
                            FontSize="16"
                            FontAttributes="Bold"/>
                        <Label
                            Text="{Binding Note}"
                            FontSize="12"/>

                        <Label
                            Text="{Binding NoteDate}"
                            FontSize="12"/>
                        <Label
                            Text="⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>
