<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="gym_assistant.MainPage">

    <Shell.TitleView>
        <Label Text="MAIN"
               FontFamily="KumarOne-Regular"
               FontSize="36"
               HorizontalOptions="Center"
               VerticalOptions="Center"/>
    </Shell.TitleView>

    <Grid
        RowDefinitions="*, * ,*"
        ColumnDefinitions="*, *, *"
        RowSpacing="20"
        ColumnSpacing="20"
        Margin="7"
        Padding="15">

        <Border
            StrokeShape="RoundRectangle 15"
            Stroke="Gray"
            StrokeThickness="2"
            Grid.Column="0"
            Grid.Row="0">
            <VerticalStackLayout VerticalOptions="Center">
                <Label Text="12"
                       FontSize="40"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"/>
                <Label Text="⎯⎯⎯⎯⎯⎯"
                       HorizontalOptions="Center"/>
                <Label Text="workouts this month"
                       FontSize="16"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"/>
            </VerticalStackLayout>
        </Border>

        <Border
            StrokeShape="RoundRectangle 15"
            Stroke="Gray"
            StrokeThickness="2"
            Grid.Column="1"
            Grid.Row="0"
            Grid.ColumnSpan="2">
            <Image Source="mock_calendar.png"
                   Margin="10"/>
        </Border>

        <Border
            StrokeShape="RoundRectangle 15"
            Stroke="Gray"
            StrokeThickness="2"
            Grid.Column="0"
            Grid.Row="1"
            Grid.ColumnSpan="2">

            <HorizontalStackLayout>
                <Label Text="73"
                       FontSize="64"
                       VerticalTextAlignment="End"
                       HorizontalTextAlignment="Start"
                       Margin="10, 0, 0, 0"/>
                <Label Text="80"
                       FontSize="64"
                       HorizontalTextAlignment="End"
                       VerticalTextAlignment="Start"
                       Margin="50, 0, 0, 0"/>
            </HorizontalStackLayout>
        </Border>

        <Border
            StrokeShape="RoundRectangle 15"
            Stroke="Gray"
            StrokeThickness="2"
            Grid.Column="2"
            Grid.Row="1">

            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Label Text="7"
                       FontSize="64"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"/>
                <Label Text="To go"
                       FontSize="24"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"/>
            </VerticalStackLayout>

        </Border>

        <Border
            StrokeShape="RoundRectangle 15"
            Stroke="Gray"
            StrokeThickness="2"
            Grid.Column="0"
            Grid.Row="2"
            Grid.ColumnSpan="3">

            <HorizontalStackLayout
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Image Source="ai.png"
                       HorizontalOptions="Start"
                       VerticalOptions="Start"
                       Margin="10"/>

                <Label Text="You’re doing a great job maintaining your workload throughout the week. Keep it up — with every day, you’re getting closer to your muscle-gaining goal."
                       FontSize="14"
                       LineBreakMode="WordWrap"
                       MaxLines="10"
                       MaximumWidthRequest="340"/>
            </HorizontalStackLayout>

        </Border>

    </Grid>

</ContentPage>
