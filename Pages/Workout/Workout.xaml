<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="gym_assistant.WorkoutPage">

        <Shell.TitleView>
                <Label Text="Workout"
                       FontFamily="KumarOne-Regular"
                       FontSize="22"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
        </Shell.TitleView>

        <VerticalStackLayout>
                <Button Text="Create workout"
                        Command="{Binding OpenCreateWorkoutCommand}"/>

                <Button Text="1"
                        Command="{Binding FirstWorkoutCommand}"/>
                <Button Text="2"
                        Command="{Binding SecondWorkoutCommand}"/>
                <Button Text="3"
                        Command="{Binding ThirdWorkoutCommand}"/>
                <Button Text="4"
                        Command="{Binding ForthWorkoutCommand}"/>
                <Button Text="5"
                        Command="{Binding FifthWorkoutCommand}"/>
                <Button Text="6"
                        Command="{Binding SixthWorkoutCommand}"/>

                <!-- <Button Text="Exercise Mode"
                        Clicked="OnExerciseModeClicked"/>
                <Button Text="Start workout"/>
                <Button Text="ShowWorkout"
                        Clicked="OnShowWorkoutClicked"/> -->
                <!-- <CollectionView x:Name="WorkoutPreview"
                                BackgroundColor="Gray"/> -->
        </VerticalStackLayout>
</ContentPage>
