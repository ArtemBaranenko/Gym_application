<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="gym_assistant.WorkoutPage">

    <Shell.TitleView>
        <Label Text="Workout"
               FontFamily="KumarOne-Regular"
               FontSize="22"
               HorizontalOptions="Center"
               VerticalOptions="Center"/>
    </Shell.TitleView>

    <VerticalStackLayout>
        <Label
            Text="Workout page"
            Padding="10"/>

        <Button Text="Create workout"
                Clicked="OnCreateWorkoutClicked"/>
        <Button Text="Exercise Mode"
                Clicked="OnExerciseModeClicked"/>
        <Button Text="Start workout"/>
    </VerticalStackLayout>
</ContentPage>
